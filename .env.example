# DevLoop Environment Variables
# Copy this to .env and fill in your values

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL + service role key (Supabase dashboard → Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Slack OAuth App ───────────────────────────────────────────────────────────
# Create at api.slack.com/apps → OAuth & Permissions → Redirect URL:
# http://localhost:8000/auth/slack/callback  (scope: incoming-webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Session ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string-in-production

# ── URLs (update when deployed) ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Sentry webhook secret (from Sentry project settings > Client Keys)
SENTRY_WEBHOOK_SECRET=

# OpenRouter API key — used for testing (takes priority over OpenAI if set)
# Get free key at https://openrouter.ai
OPENROUTER_API_KEY=
# Second OpenRouter key (different account) — used as backup if key 1 hits rate limits
OPENROUTER_API_KEY_2=

# OpenRouter model (default: best free model)
OPENROUTER_MODEL=

# OpenAI API key with access to codex-mini-latest (used if OPENROUTER_API_KEY not set)
OPENAI_API_KEY=dummy_key_for_example_only

# GitHub personal access token (needs repo + pull_request scopes)
GITHUB_TOKEN=

# Target repo in owner/reponame format
GITHUB_REPO=owner/repo

# Base branch to create fixes from and PRs against
GITHUB_BASE_BRANCH=main

# Slack incoming webhook URL
SLACK_WEBHOOK_URL=

# Test command to run inside Docker sandbox
TEST_COMMAND=pytest

# Docker image for sandbox test runner
DOCKER_IMAGE=python:3.11-slim
